{
  "manifest_version": 3,
  "name": "GeeksforGeeks Focus Mode & Ad Cleaner",
  "version": "1.0.0",
  "description": "Removes side ads, course promotions, job widgets, and banner distractions on GeeksforGeeks for a clean, distraction-free reading experience.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.geeksforgeeks.org/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.geeksforgeeks.org/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
